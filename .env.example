# Copy to .env at the repo root and fill in. .env is gitignored — never commit it.
GEMINI_API_KEY=your-key-here

# Optional overrides (defaults in lloom-lab/src/lloom_lab/config.py)
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_DAILY_LIMIT=500
# Proactive requests-per-minute cap (client spaces calls at 60/RPM*1.15 s)
# GEMINI_RPM_LIMIT=15
# Failover pool used automatically when the primary's daily cap is exhausted
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# GEMINI_FALLBACK_DAILY_LIMIT=500
# Gemma 4 31B: large pool, enable only after the capability probe passes
# GEMMA_MODEL=gemma-4-31b-it
# GEMMA_DAILY_LIMIT=14000
# GEMMA_RPM_LIMIT=30
# GEMINI_ENABLE_GEMMA=1
# QWEN_PORT=8123
# QWEN_NGL=25
